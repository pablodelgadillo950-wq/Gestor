# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env al repositorio.

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=Gestor
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
# true en Azure SQL; en local normalmente false
DB_ENCRYPT=false
# true para certificados autofirmados en desarrollo local
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
# Usa una cadena larga y aleatoria (p. ej. 64+ caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=8h

# --- bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- CORS ---
CORS_ORIGIN=http://localhost:3000
